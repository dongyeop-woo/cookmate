node_modules/
android/
ios/
# 단, modules/<name>/ios 안의 네이티브 소스는 EAS 빌드에 반드시 포함되어야 하므로 unignore
!modules/*/ios/
!modules/*/ios/**
.expo/
dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
.env
cookingbasedyw-firebase-adminsdk-fbsvc-b11f8d8de0.json
cookingbasedyw-d37cc782696c.json
# Google Cloud / Firebase service account keys
*-iam-*.json
*service-account*.json

# 생성된 레시피 이미지 (Firebase Storage 업로드 후 로컬 사본은 무시)
images/

# macOS
.DS_Store

# Python 가상환경 (레시피 스크립트용, 커밋 대상 아님)
venv/
.python-version

# 인스타 카드 생성물 — 장당 1MB 넘게 쌓인다
out/
scripts/__pycache__/

# 배달의민족 주아체: 사용은 무료지만 폰트 파일 재배포는 금지.
# 각자 https://www.woowahan.com/fonts 에서 받아 assets/fonts/BMJUA.otf 로 두세요.
assets/fonts/

# 카드 자산 원본(대용량). 가공 결과물만 커밋한다.
assets/NewIcon.PNG
assets/test2.jpg
assets/deco-spoonandfork.png
assets/mascot-cut.png
assets/brand-mark-green.png

# Apple/Google 브랜드 자산 — 저장소에 재배포하지 않는다. 받는 법:
#   curl -sL "https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/ko-kr?size=500x166" -o /tmp/b.svg \
#     && magick -background none -density 900 /tmp/b.svg -resize x250 assets/badge-appstore.png
#   curl -sL "https://play.google.com/intl/en_us/badges/static/images/badges/ko_badge_web_generic.png" -o assets/badge-googleplay.png
assets/badge-appstore.png
assets/badge-googleplay.png

# Cafe24 Ssurround — 사용은 무료지만 폰트 파일 재배포는 금지.
# https://fonts.cafe24.com 에서 받아 assets/ 에 두세요.
assets/Cafe24Ssurround-*.ttf
assets/Cafe24Ssurround-*.otf
# 메모멘트 꾸꾸 (본문 손글씨체) — 동일
assets/MemomentKkukkukk.*
